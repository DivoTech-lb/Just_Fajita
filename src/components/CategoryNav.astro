---
const { categories = [] } = Astro.props;

const primary = categories
  .filter((c) => c.type !== 'special')
  .map((c) => ({ id: c.id, label: c.category_en }));

const secondary = categories
  .filter((c) => c.type === 'special' && c.items?.length)
  .map((c) => ({ id: c.id, label: c.category_en }));
---

<nav class="rail" aria-label="Menu categories">
  <div class="rail__row rail__row--main">
    <div class="rail__viewport">
      <button class="rail__arrow rail__arrow--left" type="button" aria-label="Scroll categories left" data-scroll-dir="-1">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4 7 12l8 8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="rail__scroll">
        {primary.map((c) => (
          <button class="pill" type="button" data-target={c.id}>{c.label}</button>
        ))}
      </div>
      <button class="rail__arrow rail__arrow--right" type="button" aria-label="Scroll categories right" data-scroll-dir="1">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 4 8 8-8 8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>

  {secondary.length > 0 && (
    <div class="rail__row rail__row--extra">
      <div class="rail__viewport">
        <button class="rail__arrow rail__arrow--left" type="button" aria-label="Scroll categories left" data-scroll-dir="-1">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4 7 12l8 8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="rail__scroll">
          {secondary.map((c) => (
            <button class="pill" type="button" data-target={c.id}>{c.label}</button>
          ))}
        </div>
        <button class="rail__arrow rail__arrow--right" type="button" aria-label="Scroll categories right" data-scroll-dir="1">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 4 8 8-8 8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  )}
</nav>

<style>
  .rail {
    position: sticky; top: var(--bar-h); z-index: 30;
        background:var(--paper);
    border-bottom: 1px solid var(--rule);
     box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
  }
  .rail__row { display: flex; align-items: center;  }
  .rail__row--main { height: var(--rail-h); }
  .rail__row--extra {
    height: var(--rail2-h);
    border-top: 1px dashed var(--rule);
  }

  .rail__viewport {
    position: relative;
    width: 100%; max-width: var(--wrap);
    min-width: 0;
    margin-inline: auto;
  }

  .rail__scroll {
    display: flex; gap: 8px;
    width: 100%;
    padding: 0 20px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .rail__scroll::-webkit-scrollbar { display: none; }

  /* scroll-hint arrows for the category rail — independent of any other
     carousel's arrows in the app; hidden (disabled) whenever the row
     doesn't overflow, or is already scrolled to that edge */
  .rail__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    display: grid; place-items: center;
    width: 28px; height: 28px;
    padding: 0;
    border: 2px solid var(--grey);
    border-radius: 50%;
    background: var(--paper);
    color: var(--grey);
    cursor: pointer;
    opacity: 0.45;
    transition: opacity .18s ease, background-color .18s ease, color .18s ease, border-color .18s ease;
  }
  .rail__arrow svg { width: 13px; height: 13px; }
  .rail__arrow:hover { background: var(--green); border-color: var(--green); color: var(--paper); }
  .rail__arrow:disabled { opacity: 0; pointer-events: none; }
  .rail__arrow--left { left: 2px; }
  .rail__arrow--right { right: 2px; }

  .pill {
    flex: none;
           border: 2px solid var(--grey);
    background: var(--paper);
    color: var(--grey);
    font-family: var(--font-body);
    font-size: 0.83rem; font-weight: 600;
    padding: 7px 15px;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color .18s ease, color .18s ease, border-color .18s ease;
    
  }
  .pill[aria-current="true"] {
    background: var(--green);
    color:var(--paper);
  border:0px #FFFF solid;
    border-radius: 999px;

  }

  /* sweets and deals read as a different kind of thing */
  .pill--extra {
    background: transparent;
    border-style: dashed;
    border-color: var(--grey);
  }
  .pill--extra[aria-current="true"] {
    background: var(--teal); border-color: var(--teal); border-style: solid; color: var(--cream);
  }
</style>

<script>
  const rail = document.querySelector('.rail');

  if (rail) {
    const pills = [...rail.querySelectorAll('.pill')];

    /* Ignore the scroll-spy until a programmatic jump has settled, otherwise
       the observer fires mid-scroll and fights the browser for the position. */
    let lockUntil = 0;

    /* Nudge the pill's own row sideways. Never scrollIntoView() a pill:
       that also moves the page vertically and snaps you back to the top. */
    const centrePill = (pill) => {
      const row = pill.parentElement;
      if (!row) return;
      const max = row.scrollWidth - row.clientWidth;
      if (max <= 0) return;
      const wanted = pill.offsetLeft - (row.clientWidth - pill.offsetWidth) / 2;
      row.scrollTo({ left: Math.min(Math.max(wanted, 0), max), behavior: 'smooth' });
    };

    const setActive = (id) => {
      pills.forEach((p) => {
        const on = p.dataset.target === id;
        p.setAttribute('aria-current', String(on));
        if (on) centrePill(p);
      });
    };

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const target = document.getElementById(pill.dataset.target);
        if (!target) return;
        lockUntil = Date.now() + 900;
        setActive(pill.dataset.target);
        target.scrollIntoView({ block: 'start' });
      });
    });

    const sections = pills
      .map((p) => document.getElementById(p.dataset.target))
      .filter(Boolean);

    if (sections.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (Date.now() < lockUntil) return;
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (visible) setActive(visible.target.id);
        },
        { rootMargin: '-160px 0px -55% 0px', threshold: 0 }
      );
      sections.forEach((s) => observer.observe(s));
      pills[0]?.setAttribute('aria-current', 'true');
    }

    /* Scroll-hint arrows: independent per-row, no relation to any other
       carousel's arrows. Disabling (rather than hiding) both fades them
       out via CSS and drops them from the tab order / click target. */
    const viewports = [...rail.querySelectorAll('.rail__viewport')];

    viewports.forEach((viewport) => {
      const scroller = viewport.querySelector('.rail__scroll');
      const leftBtn = viewport.querySelector('.rail__arrow--left');
      const rightBtn = viewport.querySelector('.rail__arrow--right');
      if (!scroller || !leftBtn || !rightBtn) return;

      const updateArrows = () => {
        const max = scroller.scrollWidth - scroller.clientWidth;
        leftBtn.disabled = scroller.scrollLeft <= 1;
        rightBtn.disabled = scroller.scrollLeft >= max - 1;
      };

      const nudgeBy = (dir) => {
        scroller.scrollBy({ left: dir * Math.round(scroller.clientWidth * 0.9), behavior: 'smooth' });
      };

      leftBtn.addEventListener('click', () => nudgeBy(-1));
      rightBtn.addEventListener('click', () => nudgeBy(1));

      scroller.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows);
      updateArrows();
    });
  }
</script>
