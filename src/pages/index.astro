---
import business from '../data/business.json';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import CategoryNav from '../components/CategoryNav.astro';
import MenuSection from '../components/MenuSection.astro';
import Offers from '../components/Offers.astro';
import Footer from '../components/Footer.astro';
import { LOGO } from '../assets.js';
import '../styles/global.css';

const { promotion, brand, menu, business_info } = business;
const currency = brand.currency_label || 'L.L.';

/* Single pass over menu.categories, split by type. Normal categories share one
   grid container (for consistent spacing); special categories render full-bleed
   outside it, same as the offers section always has. */
const normalCategories = [];
const specialCategories = [];
for (const category of menu.categories) {
  (category.type === 'special' ? specialCategories : normalCategories).push(category);
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{brand.name} — Restaurant Food &amp; Drinks</title>
  <meta name="description" content={`${brand.name} — burgers, zinger, sandwiches, wraps, plates and crepes. ${brand.tagline_en}.`} />
  <link rel="icon" href={LOGO} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=IBM+Plex+Sans+Arabic:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <a class="skip" href="#menu">Skip to menu</a>

  <TopBar promotion={promotion} whatsapp={business_info.whatsapp} />
  <Hero brand={brand} />
  <CategoryNav categories={menu.categories} />

  <main>
    <div id="menu" class="wrap menu">
      {normalCategories.map((category) => (
        <MenuSection category={category} currency={currency} />
      ))}
    </div>

    {specialCategories.map((category) => (
      <Offers category={category} currency={currency} />
    ))}
  </main>

  <Footer info={business_info} brand={brand} />
</body>
</html>

<style>
  .menu { padding: 30px 20px 10px; }
</style>
